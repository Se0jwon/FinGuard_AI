 = baseUrl.TrimEnd(&quot;/&quot;c) &amp; &quot;/api/automation/robot/requests/&quot; &amp; Uri.EscapeDataString(requestId) &amp; &quot;/receipt&quot;&#xA;Dim body = New Newtonsoft.Json.Linq.JObject(New Newtonsoft.Json.Linq.JProperty(&quot;dispatch_id&quot;, dispatchId))&#xA;Try&#xA;    Using handler As New System.Net.Http.HttpClientHandler With {.AllowAutoRedirect = False}&#xA;        Using client As New System.Net.Http.HttpClient(handler)&#xA;            client.Timeout = TimeSpan.FromSeconds(15)&#xA;            Using message As New System.Net.Http.HttpRequestMessage(System.Net.Http.HttpMethod.Post, address)&#xA;                message.Headers.Authorization = New System.Net.Http.Headers.AuthenticationHeaderValue(&quot;Bearer&quot;, token)&#xA;                message.Content = New System.Net.Http.StringContent(body.ToString(Newtonsoft.Json.Formatting.None), System.Text.Encoding.UTF8, &quot;application/json&quot;)&#xA;                Using response = client.SendAsync(message).GetAwaiter().GetResult()&#xA;                    failure = &quot;CRM_REJECTED&quot;&#xA;                    If Not response.IsSuccessStatusCode Then Return&#xA;                    failure = &quot;CRM_INVALID_RESPONSE&quot;&#xA;                    Dim data = Newtonsoft.Json.Linq.JObject.Parse(response.Content.ReadAsStringAsync().GetAwaiter().GetResult())&#xA;                    Dim number = data.Value(Of String)(&quot;incident_id&quot;)&#xA;                    Dim state = data.Value(Of String)(&quot;status&quot;)&#xA;                    If data.Value(Of String)(&quot;request_id&quot;) &lt;&gt; requestId OrElse String.IsNullOrWhiteSpace(number) OrElse (state &lt;&gt; &quot;SUCCESS&quot; AndAlso state &lt;&gt; &quot;DUPLICATE&quot;) Then Return&#xA;                    receipt = number&#xA;                    result = state&#xA;                    failure = String.Empty&#xA;                End Using&#xA;            End Using&#xA;        End Using&#xA;    End Using&#xA;Catch ex As System.Threading.Tas